{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asymmetrica-landing",
  "main": "worker.js",
  "compatibility_date": "2026-09-24",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ]
}
